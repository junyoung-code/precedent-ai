LAW_OPEN_DATA_OC=
DATABASE_URL=postgres://precedent_ai:precedent_ai_local@127.0.0.1:54329/precedent_ai
SYNC_LIMIT=20
VERIFY_LIMIT=100
API_PORT=8787
EMBEDDING_SEARCH_ENABLED=false
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BACKFILL_LIMIT=100
SUMMARY_MODEL=gpt-5-mini
SUMMARY_BACKFILL_LIMIT=100

# 법조문 분석에 쓸 모델. 기본값은 없습니다 — 후보를 같은 입력으로 비교해 고르십시오.
# npm run analysis:compare
ANALYSIS_MODEL=
# 켜면 비슷한 상황을 겪은 사람들의 글을 웹에서 함께 찾습니다.
# 검색 1회당 비용과 지연이 늘어납니다.
ANALYSIS_WEB_SEARCH=false
# 개발자용 사용량·비용 대시보드를 /dev/usage 에 엽니다. 배포 시에는 꺼두십시오.
DEV_DASHBOARD=false
