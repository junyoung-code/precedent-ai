LAW_OPEN_DATA_OC=
DATABASE_URL=postgres://precedent_ai:precedent_ai_local@127.0.0.1:54329/precedent_ai
SYNC_LIMIT=20
VERIFY_LIMIT=100
API_PORT=8787
EMBEDDING_SEARCH_ENABLED=false
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BACKFILL_LIMIT=100
SUMMARY_MODEL=gpt-5-mini
SUMMARY_BACKFILL_LIMIT=100

# 법조문 분석에 쓸 모델. 기본값은 없습니다 — 후보를 같은 입력으로 비교해 고르십시오.
# npm run analysis:compare
ANALYSIS_MODEL=
# 켜면 AI 분석이 유료 안내 화면으로 잠깁니다. 잠기면 모델을 아예 호출하지
# 않으므로 그 검색의 분석 비용은 0원입니다. 조문·요건 표시와 비슷한 사례는
# 잠금과 무관하게 계속 보입니다.
ANALYSIS_PAYWALL=false
# 개발자용 사용량·비용 대시보드를 /dev/usage 에 엽니다. 배포 시에는 꺼두십시오.
DEV_DASHBOARD=false

# 켜면 외부 호출을 한 번도 하지 않습니다 — 분석은 저장된 실제 응답을 쓰고,
# 웹 사례는 캐시만 읽으며, 임베딩도 부르지 않습니다. 화면을 반복해서 열어보는
# UI 작업용입니다. 비용 0원.
OFFLINE_MODE=false

# 웹 사례 배치를 며칠이나 그대로 쓸지. 이 시간이 지나면 페이지를 여는 사람이
# 갱신을 유발하고, 갱신은 이 기능에서 가장 비싼 동작입니다 — 모델 호출 2회에
# 그중 하나는 web_search 도구라 호출당 따로 과금됩니다. 키가 28개이므로
# 기본값 24시간이면 하루 최대 28회입니다.
#
# 화면을 직접 써보며 테스트하는 기간에는 길게(예: 720) 두고, 갱신은
# `npm run web:warm` 으로만 의도적으로 하세요. 비워두면 24시간입니다.
WEB_CACHE_TTL_HOURS=24
