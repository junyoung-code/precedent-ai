{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env.local scripts/api-server.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:up": "docker compose up -d db",
    "sync:law": "node --env-file=.env.local scripts/sync-law-open-data.mjs",
    "rights:law": "node --env-file-if-exists=.env.local scripts/review-law-open-data-rights.mjs",
    "verify:sources": "node --env-file-if-exists=.env.local scripts/verify-sources.mjs",
    "tags:backfill": "node --env-file-if-exists=.env.local scripts/backfill-fact-tags.mjs",
    "embeddings:backfill": "node --env-file-if-exists=.env.local scripts/backfill-embeddings.mjs",
    "summaries:backfill": "node --env-file-if-exists=.env.local scripts/backfill-summaries.mjs",
    "summaries:estimate": "node --env-file-if-exists=.env.local scripts/estimate-summaries.mjs",
    "data:check": "node --env-file-if-exists=.env.local scripts/check-data-integrity.mjs",
    "data:prune": "node --env-file-if-exists=.env.local scripts/prune-unrelated-precedents.mjs",
    "intake:purge": "node --env-file-if-exists=.env.local scripts/purge-expired-intake-sessions.mjs",
    "quality:evaluate": "node --env-file-if-exists=.env.local scripts/evaluate-search-quality.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
